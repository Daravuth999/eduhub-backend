 /**
  * assessments.css — AI Assessment / Quiz Submission Lab, student surface.
  * Own, independent stylesheet (same one-file-per-feature convention as
- * videoLibrary.css) — the phase-cross-fade keyframe is deliberately
- * duplicated rather than imported, matching this codebase's established
- * per-feature CSS isolation.
+ * videoLibrary.css).
+ *
+ * DAY MODE (v2): every Assessment Lab student surface is wrapped in
+ * `.asmt-theme`. The blanket `text-white` / `border-white/*` / `bg-white/*`
+ * utilities this feature originally shipped with are remapped here onto the
+ * app's REAL theme tokens (premium-tokens.css's --eh-ink-* / --eh-border-* /
+ * --eh-surface-* ramps), so Day Mode readability comes from the underlying
+ * theme system — not hardcoded white/black overrides. Dark mode is
+ * unchanged: these variables resolve to the same white-alpha values there.
  */
+
+/* ── theme-token remap (Day Mode fix) ─────────────────────────────────── */
+html[data-theme="light"] .asmt-theme .text-white { color: var(--eh-ink-1); }
+html[data-theme="light"] .asmt-theme [class*="text-white/"] { color: var(--eh-ink-2); }
+html[data-theme="light"] .asmt-theme [class*="text-white/4"],
+html[data-theme="light"] .asmt-theme [class*="text-white/3"] { color: var(--eh-ink-3); }
+html[data-theme="light"] .asmt-theme [class*="border-white/"] { border-color: var(--eh-border-2); }
+html[data-theme="light"] .asmt-theme [class*="bg-white/"] { background-color: rgba(13, 10, 20, 0.04); }
+html[data-theme="light"] .asmt-theme .bg-black\/30,
+html[data-theme="light"] .asmt-theme .bg-black\/20 { background-color: var(--eh-surface-2); }
+
+html[data-theme="light"] .asmt-modal-overlay {
+  background: rgba(13, 10, 20, 0.35) !important;
+}
+html[data-theme="light"] .asmt-modal-card {
+  background: var(--eh-surface-1);
+  border-color: var(--eh-border-2);
+  color: var(--eh-ink-1);
+  box-shadow: var(--eh-shadow-3);
+}
+
+/* ── phase cross-fade ─────────────────────────────────────────────────── */
 @keyframes asmt-phase-in {
   from { opacity: 0; transform: translateY(10px); }
   to   { opacity: 1; transform: translateY(0); }
@@ -12,8 +40,48 @@
 
 .asmt-phase-in { animation: asmt-phase-in 260ms cubic-bezier(0.22, 1, 0.36, 1) both; }
 
+/* ── immersive submission progress (READY → … → SUBMITTED journey) ────── */
+@keyframes asmt-shimmer {
+  0%   { background-position: -200% 0; }
+  100% { background-position: 200% 0; }
+}
+@keyframes asmt-stage-pop {
+  0%   { transform: scale(0.6); opacity: 0; }
+  60%  { transform: scale(1.12); }
+  100% { transform: scale(1); opacity: 1; }
+}
+@keyframes asmt-pulse-ring {
+  0%   { box-shadow: 0 0 0 0 rgba(212, 168, 67, 0.45); }
+  100% { box-shadow: 0 0 0 10px rgba(212, 168, 67, 0); }
+}
+
+.asmt-progress-track {
+  height: 4px;
+  border-radius: 999px;
+  background: rgba(212, 168, 67, 0.16);
+  overflow: hidden;
+}
+.asmt-progress-fill {
+  height: 100%;
+  border-radius: 999px;
+  background: linear-gradient(90deg, rgba(212, 168, 67, 0.55), #d4a843, rgba(212, 168, 67, 0.55));
+  background-size: 200% 100%;
+  animation: asmt-shimmer 1.6s linear infinite;
+  transition: width 600ms cubic-bezier(0.22, 1, 0.36, 1);
+}
+.asmt-stage-icon-active {
+  animation: asmt-stage-pop 380ms cubic-bezier(0.22, 1, 0.36, 1) both,
+             asmt-pulse-ring 1.4s ease-out infinite;
+}
+.asmt-stage-done { animation: asmt-stage-pop 300ms cubic-bezier(0.22, 1, 0.36, 1) both; }
+.asmt-stage-row { transition: opacity 400ms ease, transform 400ms ease; }
+
 @media (prefers-reduced-motion: reduce) {
   .asmt-modal-overlay,
   .asmt-modal-card,
-  .asmt-phase-in { animation: none !important; }
+  .asmt-phase-in,
+  .asmt-progress-fill,
+  .asmt-stage-icon-active,
+  .asmt-stage-done,
+  .asmt-stage-row { animation: none !important; transition: none !important; }
 }
