.yarn/install-state.gz
.pnp.*

# Build output
build/
dist/
out/
coverage/
.cache/

# Release ZIPs — NEVER commit a packaged release into the repo
public/downloads/*.zip
*.zip

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Misc
*.log
.eslintcache
.firebase/
