     seen: set[str] = set()
     for it in raw_items[:max_items]:
@@ -236,7 +252,18 @@ def normalize_extracted_submission_answers(raw_items, known_question_ids, *,
             confidence = max(0.0, min(1.0, confidence))
         except (TypeError, ValueError):
             confidence = None
